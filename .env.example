# Optional OpenAI-compatible service; leave blank for deterministic rule mode.
RENEWAL_AI_BASE_URL=
RENEWAL_AI_API_KEY=
RENEWAL_AI_MODEL=
# Demo-only experiment salt. Configure a secret for real deployments.
RENEWAL_EXPERIMENT_SALT=change-me-before-real-use
# Optional file path for local SQLite
RENEWAL_DB_PATH=

# G1-E: local synthetic development only. Never commit real database credentials.
# RENEWAL_AUTH_BACKEND=postgres
