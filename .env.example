# Optional OpenAI-compatible service; leave blank for deterministic rule mode.
RENEWAL_AI_BASE_URL=
RENEWAL_AI_API_KEY=
RENEWAL_AI_MODEL=
# Demo-only experiment salt. Configure a secret for real deployments.
RENEWAL_EXPERIMENT_SALT=change-me-before-real-use
# Optional file path for local SQLite
RENEWAL_DB_PATH=

# G1-E: local synthetic development only. Never commit real database credentials.
# RENEWAL_AUTH_BACKEND=postgres
# RENEWAL_PG_AUTH_DSN=postgresql://DEDICATED_AUTH_ROLE@127.0.0.1:5432/YOUR_TEST_DB
# RENEWAL_PG_APP_DSN=postgresql://DEDICATED_BUSINESS_ROLE@127.0.0.1:5432/YOUR_TEST_DB

# G1-H local-only federated identity prototype (never public until provider accepted)
# RENEWAL_AUTH_BACKEND=oidc
# RENEWAL_OIDC_ISSUER=https://IDP.example.com/tenant
# RENEWAL_OIDC_CLIENT_ID=CLIENT_ASSIGNED_BY_IDP
# RENEWAL_OIDC_AUTHORIZATION_ENDPOINT=https://IDP.example.com/authorize
# RENEWAL_OIDC_TOKEN_ENDPOINT=https://IDP.example.com/token
# RENEWAL_OIDC_JWKS_URI=https://IDP.example.com/keys
# RENEWAL_OIDC_REDIRECT_URI=http://127.0.0.1:8000/
# RENEWAL_OIDC_REQUIRED_ACR=IDP_DEFINED_MFA_ACR
# RENEWAL_OIDC_CLIENT_SECRET=  # optional confidential-client secret; never commit actual value
